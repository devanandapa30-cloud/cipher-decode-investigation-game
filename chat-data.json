{
    "ponnappan": {
        "messages": [
            {
                "sender": "Ponnappan",
                "text": "Kurup, where are we going now?",
                "date": "22 Jan 1984",
                "time": "05:00 AM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "Take me to the railway station. Compartment number 21A.",
                "date": "22 Jan 1984",
                "time": "05:02 AM"
            },
            {
                "sender": "Ponnappan",
                "text": "Are you leaving tonight?",
                "date": "22 Jan 1984",
                "time": "05:03 AM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "Yes. I’m going to Bombay.",
                "date": "22 Jan 1984",
                "time": "05:05 AM"
            },
            {
                "sender": "Ponnappan",
                "text": "Why Bombay?",
                "date": "22 Jan 1984",
                "time": "05:06 AM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "I have a friend there. Isaac. I need to meet him.",
                "date": "22 Jan 1984",
                "time": "05:08 AM"
            },
            {
                "sender": "Ponnappan",
                "text": "Does Isaac know you're coming?",
                "date": "22 Jan 1984",
                "time": "05:10 AM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "He will soon.",
                "date": "22 Jan 1984",
                "time": "05:11 AM"
            },
            {
                "sender": "Ponnappan",
                "text": "What will you do after meeting him?",
                "date": "22 Jan 1984",
                "time": "05:12 AM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "I have another person to meet through him.",
                "date": "22 Jan 1984",
                "time": "05:15 AM"
            },
            {
                "sender": "Ponnappan",
                "text": "Do you think you'll be safe there?",
                "date": "22 Jan 1984",
                "time": "05:16 AM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "I just need to stay away from here.",
                "date": "22 Jan 1984",
                "time": "05:18 AM"
            },
            {
                "sender": "Ponnappan",
                "text": "And what about what happened tonight?",
                "date": "22 Jan 1984",
                "time": "05:20 AM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "Don't talk about it.",
                "date": "22 Jan 1984",
                "time": "05:22 AM"
            },
            {
                "sender": "Ponnappan",
                "text": "Kurup… are you sure about leaving?",
                "date": "22 Jan 1984",
                "time": "05:25 AM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "There is nothing left for me here.",
                "date": "22 Jan 1984",
                "time": "05:27 AM"
            },
            {
                "sender": "Ponnappan",
                "text": "The station is ahead.",
                "date": "22 Jan 1984",
                "time": "05:30 AM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "Good. Stop there.",
                "date": "22 Jan 1984",
                "time": "05:31 AM"
            },
            {
                "sender": "Ponnappan",
                "text": "What if I never see you again?",
                "date": "22 Jan 1984",
                "time": "05:32 AM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "Then remember that tonight was the last time you drove me.",
                "date": "22 Jan 1984",
                "time": "05:35 AM"
            }
        ]
    },
    "lalitha": {
        "messages": [
            {
                "sender": "Sukumara Kurup",
                "text": "Aunty, are you still staying at the same house in Bhopal?",
                "date": "01 Feb 1984",
                "time": "02:00 PM"
            },
            {
                "sender": "Lalitha",
                "text": "Yes. Why do you ask?",
                "date": "01 Feb 1984",
                "time": "02:05 PM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "I might need to come there for a while.",
                "date": "01 Feb 1984",
                "time": "02:08 PM"
            },
            {
                "sender": "Lalitha",
                "text": "Come? Is everything alright?",
                "date": "01 Feb 1984",
                "time": "02:12 PM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "Things here have become complicated. I just need somewhere quiet.",
                "date": "01 Feb 1984",
                "time": "02:15 PM"
            },
            {
                "sender": "Lalitha",
                "text": "You can stay here, of course. You're family.",
                "date": "01 Feb 1984",
                "time": "02:20 PM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "I don't want anyone asking too many questions.",
                "date": "01 Feb 1984",
                "time": "02:21 PM"
            },
            {
                "sender": "Lalitha",
                "text": "Then don't worry. Come when you can.",
                "date": "01 Feb 1984",
                "time": "02:25 PM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "Thank you, Aunty. I may arrive without much notice.",
                "date": "01 Feb 1984",
                "time": "02:28 PM"
            },
            {
                "sender": "Lalitha",
                "text": "I'll be here. Just be careful, whatever has happened.",
                "date": "01 Feb 1984",
                "time": "02:30 PM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "I will. And please don't tell anyone that I contacted you.",
                "date": "01 Feb 1984",
                "time": "02:32 PM"
            }
        ]
    },
    "sharadha": {
        "messages": [
            {
                "sender": "Sharadha Kurup",
                "text": "we are already financially stable. Do we really need the insurance?",
                "date": "12 Jul 1983",
                "time": "10:00 AM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "Yes. It’s just for some additional support.",
                "date": "12 Jul 1983",
                "time": "10:05 AM"
            },
            {
                "sender": "Sharadha Kurup",
                "text": "Additional support for what?",
                "date": "12 Jul 1983",
                "time": "10:06 AM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "Nothing to worry about. It’s simply a safety net for the family. If something unexpected happens, at least there’ll be something to fall back on.",
                "date": "12 Jul 1983",
                "time": "10:10 AM"
            },
            {
                "sender": "Sharadha Kurup",
                "text": "Hmm… I still feel it’s a lot of money.",
                "date": "12 Jul 1983",
                "time": "10:12 AM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "Think of it as protecting what we already have. We won’t regret having it if we ever need it.",
                "date": "12 Jul 1983",
                "time": "10:15 AM"
            },
            {
                "sender": "Sharadha Kurup",
                "text": "Okay… if you’re sure..",
                "date": "12 Jul 1983",
                "time": "10:18 AM"
            },
            {
                "sender": "Sharadha Kurup",
                "text": "You asked about the old papers?",
                "date": "12 Jul 1983",
                "time": "10:25 AM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "Yes. Where are they?",
                "date": "12 Jul 1983",
                "time": "10:30 AM"
            },
            {
                "sender": "Sharadha Kurup",
                "text": "With the man who is family to me, but not by blood to you. He became your family when you became mine.",
                "date": "12 Jul 1983",
                "time": "10:32 AM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "You really want me to solve a riddle?",
                "date": "12 Jul 1983",
                "time": "10:35 AM"
            },
            {
                "sender": "Sharadha Kurup",
                "text": "It's not safe anymore",
                "date": "12 Jul 1983",
                "time": "10:36 AM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "Fine. I'll find him.",
                "date": "12 Jul 1983",
                "time": "10:40 AM"
            },
            {
                "sender": "Sharadha Kurup",
                "text": "Where are you now?",
                "date": "02 Feb 1984",
                "time": "08:00 PM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "Somewhere familiar.",
                "date": "02 Feb 1984",
                "time": "08:05 PM"
            },
            {
                "sender": "Sharadha Kurup",
                "text": "Are you coming home?",
                "date": "02 Feb 1984",
                "time": "08:06 PM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "Not yet.",
                "date": "02 Feb 1984",
                "time": "08:10 PM"
            },
            {
                "sender": "Sharadha Kurup",
                "text": "You always said you wanted to finish that house.",
                "date": "02 Feb 1984",
                "time": "08:12 PM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "Some unfinished things are better left unfinished.",
                "date": "02 Feb 1984",
                "time": "08:15 PM"
            },
            {
                "sender": "Sharadha Kurup",
                "text": "Which house are you talking about?",
                "date": "02 Feb 1984",
                "time": "08:20 PM"
            },
            {
                "sender": "Kurup",
                "text": "The one with the view.",
                "date": "02 Feb 1984",
                "time": "08:25 PM"
            }
        ]
    },
    "isaac": {
        "messages": [
            {
                "sender": "Sukumara Kurup",
                "text": "I need to get out of Bombay soon. Do you know anyone who can help?",
                "date": "13 Feb 1984",
                "time": "08:00 PM"
            },
            {
                "sender": "Isaac",
                "text": "I know someone.",
                "date": "13 Feb 1984",
                "time": "08:15 PM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "The same person you mentioned before?",
                "date": "13 Feb 1984",
                "time": "08:17 PM"
            },
            {
                "sender": "Isaac",
                "text": "Yes.",
                "date": "13 Feb 1984",
                "time": "08:20 PM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "I need to be certain it's him and don't be obvious.",
                "date": "13 Feb 1984",
                "time": "08:25 PM"
            },
            {
                "sender": "Isaac",
                "text": "Of course.",
                "date": "13 Feb 1984",
                "time": "08:30 PM"
            },
            {
                "sender": "Isaac",
                "text": "",
                "image": "assets/IMG_0827.PNG",
                "date": "13 Feb 1984",
                "time": "08:32 PM"
            },
            {
                "sender": "Isaac",
                "text": "“I have no mouth, yet I speak,\nno hands, yet I point.\nLook at the man who holds the night,\nbut not the man himself.\nWhat he carries is empty—\nfind the number behind the shadow.”",
                "date": "13 Feb 1984",
                "time": "08:35 PM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "Got it.",
                "date": "13 Feb 1984",
                "time": "08:40 PM"
            },
            {
                "sender": "Isaac",
                "text": "Good.",
                "date": "13 Feb 1984",
                "time": "08:42 PM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "Thanks. That's enough.",
                "date": "13 Feb 1984",
                "time": "08:45 PM"
            }
        ]
    },
    "leo": {
        "messages": [
            {
                "sender": "Sukumara Kurup",
                "text": "I need to leave soon. Can you still help?",
                "date": "15 Feb 1984",
