            },
            {
                "sender": "Sukumara Kurup",
                "text": "And beyond Bombay?",
                "date": "15 Feb 1984",
                "time": "09:07 PM"
            },
            {
                "sender": "Leo Kavinsky",
                "text": "The place we talked about is still possible.",
                "date": "15 Feb 1984",
                "time": "09:10 PM"
            },
            {
                "sender": "Leo Kavinsky",
                "text": "Where ancient kings once ruled, where the Gulf meets an old land, and where the name begins with the letter P.",
                "date": "15 Feb 1984",
                "time": "09:12 PM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "That place?",
                "date": "15 Feb 1984",
                "time": "09:15 PM"
            },
            {
                "sender": "Leo Kavinsky",
                "text": "Exactly.",
                "date": "15 Feb 1984",
                "time": "09:16 PM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "Understood. I'll contact you when I'm ready.",
                "date": "15 Feb 1984",
                "time": "09:20 PM"
            }
        ]
    },
    "ar_builders": {
        "messages": [
            {
                "sender": "Sukumara Kurup",
                "text": "Did you get the revised plan?",
                "date": "12 Feb 1983",
                "time": "09:15 AM"
            },
            {
                "sender": "AR Builders",
                "text": "Yes. I looked through it this morning.",
                "date": "12 Feb 1983",
                "time": "09:42 AM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "Any problems?",
                "date": "12 Feb 1983",
                "time": "09:45 AM"
            },
            {
                "sender": "AR Builders",
                "text": "Nothing major. But the front portion will need to be changed slightly.",
                "date": "12 Feb 1983",
                "time": "10:05 AM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "Why?",
                "date": "12 Feb 1983",
                "time": "10:08 AM"
            },
            {
                "sender": "AR Builders",
                "text": "The view from the upper floor will be better if we move the windows toward the eastern side.",
                "date": "12 Feb 1983",
                "time": "10:15 AM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "Do it.",
                "date": "12 Feb 1983",
                "time": "10:18 AM"
            },
            {
                "sender": "AR Builders",
                "text": "And about the name?",
                "date": "12 Feb 1983",
                "time": "10:20 AM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "And don't put the name on the front yet.",
                "date": "12 Feb 1983",
                "time": "10:22 AM"
            },
            {
                "sender": "AR Builders",
                "text": "Why?",
                "date": "12 Feb 1983",
                "time": "10:25 AM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "The house isn't finished.",
                "date": "12 Feb 1983",
                "time": "10:26 AM"
            },
            {
                "sender": "AR Builders",
                "text": "Fair enough. What about the upper floor?",
                "date": "12 Feb 1983",
                "time": "10:30 AM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "Keep it simple. I want a quiet room there.",
                "date": "12 Feb 1983",
                "time": "10:35 AM"
            },
            {
                "sender": "AR Builders",
                "text": "I'll update the plan.",
                "date": "12 Feb 1983",
                "time": "10:45 AM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "Send me the final drawing when it's ready.",
                "date": "12 Feb 1983",
                "time": "10:50 AM"
            },
            {
                "sender": "AR Builders",
                "text": "Will do.",
                "date": "12 Feb 1983",
                "time": "11:05 AM"
            },
            {
                "sender": "AR Builders",
                "text": "The house is coming up nicely.",
                "date": "05 Dec 1983",
                "time": "02:00 PM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "Good. What about the location details?",
                "date": "05 Dec 1983",
                "time": "02:15 PM"
            },
            {
                "sender": "AR Builders",
                "text": "View from the front is beautiful.",
                "date": "05 Dec 1983",
                "time": "02:30 PM"
            },
            {
                "sender": "AR Builders",
                "text": "All the windows on the eastern side are done.",
                "date": "05 Dec 1983",
                "time": "02:31 PM"
            },
            {
                "sender": "AR Builders",
                "text": "Nearby, the water makes the place very quiet.",
                "date": "05 Dec 1983",
                "time": "02:33 PM"
            },
            {
                "sender": "AR Builders",
                "text": "Don't change the entrance design.",
                "date": "05 Dec 1983",
                "time": "02:35 PM"
            },
            {
                "sender": "AR Builders",
                "text": "After the plastering, we'll finish the upper floor.",
                "date": "05 Dec 1983",
                "time": "02:40 PM"
            },
            {
                "sender": "AR Builders",
                "text": "Next week I'll bring the final plan.",
                "date": "05 Dec 1983",
                "time": "02:45 PM"
            },
            {
                "sender": "AR Builders",
                "text": "All that's left is the interior work.",
                "date": "05 Dec 1983",
                "time": "02:50 PM"
            },
            {
                "sender": "AR Builders",
                "text": "Maybe we'll finish before the monsoon.",
                "date": "05 Dec 1983",
                "time": "03:00 PM"
            }
        ]
    },
    "pillai": {
        "messages": [
