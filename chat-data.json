    "shahu": {
        "messages": [
            {
                "sender": "Sukumara Kurup",
                "text": "Shahu, do you still remember the insurance policy we discussed in Abu Dhabi?",
                "date": "27 Nov 1983",
                "time": "10:00 PM"
            },
            {
                "sender": "Shahu",
                "text": "Yes. The large policy. You're still thinking about claiming it?",
                "date": "27 Nov 1983",
                "time": "10:05 PM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "I have to. The money would solve everything.",
                "date": "27 Nov 1983",
                "time": "10:06 PM"
            },
            {
                "sender": "Shahu",
                "text": "Kurup, this sounds serious. What are you planning?",
                "date": "27 Nov 1983",
                "time": "10:10 PM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "I need to make it appear as if I'm no longer here.",
                "date": "27 Nov 1983",
                "time": "10:15 PM"
            },
            {
                "sender": "Shahu",
                "text": "Are you saying you're planning to fake your own death?",
                "date": "27 Nov 1983",
                "time": "10:16 PM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "That's the idea.",
                "date": "27 Nov 1983",
                "time": "10:17 PM"
            },
            {
                "sender": "Shahu",
                "text": "And do you have a team of people back in your hometown who would help you do this?",
                "date": "27 Nov 1983",
                "time": "10:20 PM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "I know a few people. I'll handle that part.",
                "date": "27 Nov 1983",
                "time": "10:22 PM"
            },
            {
                "sender": "Shahu",
                "text": "Be careful. Once other people become involved, there's no turning back.",
                "date": "27 Nov 1983",
                "time": "10:25 PM"
            },
            {
                "sender": "Sukumara Kurup",
                "text": "I know. But I've already decided.",
                "date": "27 Nov 1983",
                "time": "10:26 PM"
            },
            {
                "sender": "Shahu",
                "text": "Then remember this conversation never happened.",
                "date": "27 Nov 1983",
                "time": "10:30 PM"
            }
        ]
    },
